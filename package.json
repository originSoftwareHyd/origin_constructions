    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "10.4.20",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  }
}
